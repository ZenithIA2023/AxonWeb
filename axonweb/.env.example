# URL do backend (local ou Railway)
VITE_API_URL=http://localhost:8000

# No build do app Android o `localhost` não existe: aponte para o backend de
# produção antes de rodar `npm run build && npx cap sync android`.
# VITE_API_URL=https://<seu-app>.up.railway.app

# Live reload no aparelho real (fase 1.7). Define o servidor de dev do Vite que
# o WebView vai carregar. Aparelho e máquina precisam se enxergar na rede, e o
# VITE_API_URL acima precisa ser alcançável pelo celular (produção ou a porta
# pública do Codespace) — não `localhost`.
# Deixe VAZIO para builds de release.
# CAP_SERVER_URL=http://192.168.0.10:5173
