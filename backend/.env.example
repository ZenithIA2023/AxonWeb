ANTHROPIC_API_KEY=sk-ant-...
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGc...
FRONTEND_URL=http://localhost:5173
# Produção: FRONTEND_URL=https://axonapp.tech

# Origens extras liberadas no CORS, separadas por vírgula.
# O WebView do app Android (Capacitor) faz requisições com origem
# "https://localhost" — sem liberá-la, o app instalado recebe 400 no preflight
# e nenhuma chamada autenticada funciona.
CORS_ORIGINS=https://localhost
# Produção: CORS_ORIGINS=https://localhost,https://axonapp.tech

# "development" habilita /docs e /redoc; qualquer outro valor (ou ausente) desabilita em produção
ENV=development

# Google OAuth (obrigatório para login com Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Produção: GOOGLE_REDIRECT_URI=https://api.axonapp.tech/auth/google/callback
# (cadastrar essa URL no Google Cloud Console antes de publicar)

# Push notifications (FCM). Use UMA das duas formas:
#  - PATH: caminho de um arquivo JSON no disco (desenvolvimento)
#  - JSON: o conteúdo colado numa variável (Railway, onde não há arquivo)
# A credencial é a "chave privada de conta de serviço" do Firebase e NUNCA
# pode ser commitada — quem a tiver envia push como se fosse a gente.
# Sem nenhuma das duas, o push simplesmente não é enviado; nada mais quebra.
FIREBASE_CREDENTIALS_PATH=/caminho/para/firebase-key.json
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}
